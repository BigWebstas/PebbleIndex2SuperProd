<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Index2SP.InputDialog"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="Index2SP">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
    <TextBox x:Name="ValueBox" PasswordChar="•" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelBtn" Content="Cancel" />
      <Button x:Name="OkBtn" Content="OK" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
