<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Index2SP</RootNamespace>
    <AssemblyName>Index2SP</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../packaging/windows/index2sp.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <Product>Index2SP</Product>
    <Description>Pebble Index 01 webhook -&gt; Super Productivity task bridge</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Index2SP.Tests" />
  </ItemGroup>

  <!-- Single self-extracting exe for both variants when publishing with a RuntimeIdentifier
       (Avalonia/Skia ship native libs via NuGet, so they must be bundled even for the
       framework-dependent build). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Self-contained only: compress the bundled runtime. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel + multipart form parsing (needs the ASP.NET Core runtime for framework-dependent builds) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <PackageReference Include="Anthropic" Version="12.47.0" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />

    <!-- HKCU Run key on Windows; throws PlatformNotSupported elsewhere (guarded at call sites) -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />

    <!-- Embedded Whisper speech-to-text engine (whisper.cpp) -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Embed native whisper.cpp binaries directly in the assembly so single-file/AppImage/etc.
       can self-extract to the user config directory if native libraries are not found on disk. -->
  <ItemGroup>
    <!-- Standard runtimes (AVX-optimized for modern CPUs) -->
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime)/build/win-x64/*.*" LogicalName="whisper_runtimes.win-x64.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime)/build/win-arm64/*.*" LogicalName="whisper_runtimes.win-arm64.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime)/build/linux-x64/*.*" LogicalName="whisper_runtimes.linux-x64.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime)/build/linux-arm64/*.*" LogicalName="whisper_runtimes.linux-arm64.%(Filename)%(Extension)" />

    <!-- NoAVX fallback runtimes (for CPUs/VMs without AVX support) -->
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime_NoAvx)/build/win-x64/*.*" LogicalName="whisper_runtimes.noavx.win-x64.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime_NoAvx)/build/win-x86/*.*" LogicalName="whisper_runtimes.noavx.win-x86.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime_NoAvx)/build/linux-x64/*.*" LogicalName="whisper_runtimes.noavx.linux-x64.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Copy native Whisper libraries for the target runtime to the publish output alongside Index2SP -->
  <Target Name="EnsureWhisperRuntimesCopied" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_WhisperRidFiles Include="$(PkgWhisper_net_Runtime)/build/$(RuntimeIdentifier)/*.*" />
      <_WhisperNoAvxRidFiles Include="$(PkgWhisper_net_Runtime_NoAvx)/build/$(RuntimeIdentifier)/*.*" Condition="Exists('$(PkgWhisper_net_Runtime_NoAvx)/build/$(RuntimeIdentifier)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WhisperRidFiles)"
          DestinationFolder="$(PublishDir)runtimes/$(RuntimeIdentifier)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WhisperNoAvxRidFiles)"
          DestinationFolder="$(PublishDir)runtimes/noavx/$(RuntimeIdentifier)"
          SkipUnchangedFiles="true"
          Condition="'@(_WhisperNoAvxRidFiles)' != ''" />
  </Target>

</Project>
