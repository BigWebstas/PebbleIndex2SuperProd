<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reverse proxy for Index2SP's Pebble webhook listener (IIS).

  Use this instead of a tunnel (cloudflared/ngrok) when you already have a
  public-facing Windows box running IIS.

  One-time prerequisites on the IIS server (not expressible in this file):
    1. Install the Application Request Routing (ARR) and URL Rewrite modules
       (Web Platform Installer, or download from iis.net).
    2. Enable ARR's proxy feature server-wide:
         %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /enabled:"True" /commit:apphost
       (or IIS Manager -> server node -> Application Request Routing Cache ->
       Server Proxy Settings -> check "Enable proxy")

  Then: create a site/application bound to your own hostname + TLS
  certificate in IIS Manager, and drop this file as its web.config.

  Assumes Index2SP is running on this same machine with its defaults
  (listenAddress 127.0.0.1, port 8787) — update the rewrite action's URL if
  you changed either in config.json.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Pebble's audio uploads can be up to ~30 MB (Index2SP's own
             Kestrel limit) — IIS's own default (~28.6 MB) would reject them
             first. 33554432 = 32 MB. -->
        <requestLimits maxAllowedContentLength="33554432" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Index2SP reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
